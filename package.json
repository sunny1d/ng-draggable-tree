{
  "name": "ngx-cdk-tree-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve ngx-cdk-tree-workspace",
    "build": "ng build ngx-cdk-tree-workspace",
    "watch": "ng build ngx-cdk-tree-workspace --watch --configuration development",
    "test": "ng test",
    "build:lib": "ng build ng-draggable-tree",
    "build:demo": "ng build ngx-cdk-tree-workspace",
    "test:lib": "ng test ng-draggable-tree --watch=false",
    "test:demo": "ng test ngx-cdk-tree-workspace --watch=false",
    "pack:lib": "ng build ng-draggable-tree && cd dist/ng-draggable-tree && npm pack",
    "publish:lib": "ng build ng-draggable-tree && cd dist/ng-draggable-tree && npm publish --registry https://registry.npmjs.org --access public"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
